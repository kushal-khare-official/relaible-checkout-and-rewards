PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@localhost:5432/checkout
DB_POOL_MAX=20
# Every n-th successfully placed order unlocks one coupon worth x% off.
REWARD_EVERY_N_ORDERS=5
REWARD_DISCOUNT_PERCENT=10
# Insert the demo catalogue on boot (idempotent: existing products are left untouched).
SEED_ON_START=true
LOG_LEVEL=info
